<h2>Shopify</h2>

<section id="lists">
    <ul>
        {{#if lists}}
            {{#each lists}}
                <li class="list-item" data-id="{{{this.id}}}">
                    <p>{{this.name}}</p>
                    <div class="action-btns">
                        <a href="{{{this.id}}}" class="icon view-btn" title="View list"><i class="fa-solid fa-eye fa-lg"></i></a>
                        <a href="{{{this.id}}}/edit" class="icon edit-btn" title="Edit list"><i class="fa-solid fa-pen fa-lg"></i></a>
                        <button class="icon copy-btn" title="Copy list id"><i class="fa-solid fa-copy fa-lg"></i></button>
                        <button class="icon del-btn" title="Delete list"><i class="fa-solid fa-trash fa-lg"></i></button>
                    </div>
                </li>
            {{/each}}
        {{/if}}
                <li id="add-list" class="list-item">
                    <form action="">
                        <input type="text" name="addList" placeholder="Add List" required autofocus>
                        <button type="submit" class="icon add-btn"><i class="fa-solid fa-plus"></i></button>
                    </form>
                </li>
    </ul>

    <img src="{{img}}" alt="woman">
</section>
