<h2>Shopify</h2>

<section id="lists">
    <div id="add-btns">
        <button id="create-btn" class="icon" title="Create list">{{includeSvg "public/img/plus.svg"}}</button>
        <button id="download-btn" class="icon" title="Download list">{{includeSvg "public/img/download.svg"}}</button>           
    </div>
    <ul>
        <li id="create-list" class="no-show list-item">
            <form>
                <input type="text" name="createList" placeholder="Insert list name" required autofocus>
                <button id="create-check-btn" class="icon check-btn">{{includeSvg "public/img/check.svg"}}</button>
            </form>
        </li>
        <li id="download-list" class="no-show list-item">
            <form action="">
                <input type="text" name="downloadList" placeholder="Insert list ID" required autofocus>
                <button type="submit" class="icon check-btn">{{includeSvg "public/img/check.svg"}}</button>
            </form>
        </li>
        {{#if lists}}
            {{#each lists}}
                <li class="shopping-list list-item" data-id="{{{this.id}}}">
                    <p>{{this.title}}</p>
                    <div class="action-btns">
                        <a href="{{{this.id}}}" class="icon view-btn" title="View list">{{includeSvg "public/img/eye.svg"}}</a>
                        <button class="icon copy-btn" title="Copy list id">{{includeSvg "public/img/copy.svg"}}</button>
                        <button class="icon del-btn" title="Delete list">{{includeSvg "public/img/trash.svg"}}</button>
                    </div>
                </li>
            {{/each}}
        {{else}}
            <li id="no-list" class="list-item">
                <p>You have yet to add any list to this device!</p>
                <p>Create a new list or download an existing one!</p>
            </li>
        {{/if}}
    </ul>

    <img src="{{img}}" alt="woman">
</section>
