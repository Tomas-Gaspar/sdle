<h2>{{{list.title}}}</h2>

<section id="lists" data-id="{{{list.id}}}">
    <div id="add-btns">
        <button id="add-item-btn" class="icon" title="Add Item">{{includeSvg "public/img/plus.svg"}}</button>
    </div>
    <ul>
        <li id="add-item" class="no-show list-item">
            <form>
                <input type="text" name="addItem" placeholder="Insert item name" required autofocus>
                <button id="add-item-check-btn" class="icon check-btn">{{includeSvg "public/img/check.svg"}}</button>
            </form>
        </li>
        {{#if list.items}}
            {{#each list.items}}
                <li class="shopping-item list-item" data-id="{{this.name}}">
                    <p>{{this.name}}</p>
                    <div class="action-btns">
                        <div class="quantity">
                            <button class="icon inc-quant-btn" title="Increase quantity">{{includeSvg "public/img/plus.svg"}}</button>
                            <p>{{this.quantity}}</p>
                            <button class="icon dec-quant-btn" title="Decrease quantity">{{includeSvg "public/img/minus.svg"}}</button>
                        </div>
                        <button class="icon del-item-btn" title="Delete item">{{includeSvg "public/img/trash.svg"}}</button>
                    </div>
                </li>
            {{/each}}
        {{else}}
            <li id="no-item" class="list-item">
                <p>You have yet to add any items to this list!</p>
            </li>
        {{/if}}
    </ul>

    <img src="{{img}}" alt="woman">
</section>
